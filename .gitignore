# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
.terraform.lock.hcl.bak
# 잠금 파일은 루트 모듈(stacks/*)에서만 커밋한다
terraform/modules/**/.terraform.lock.hcl

# render-config.sh가 만드는 값 파일 (terraform output 기반)
releases/generated/

# 비밀값
*.pem
*.key
.env
.env.*
!.env.example
# 저장소 최상위의 비밀 폴더만 제외한다(terraform/modules/secrets 같은 모듈은 커밋 대상)
/secrets/

# 개인 설정
CLAUDE.local.md
.DS_Store
.idea/
.vscode/
